# Copy to .env and fill in. Used by main.py when you run uvicorn.

# Where appointment notifications are sent (your business inbox)
APPOINTMENT_TO_EMAIL=office@example.com

# From address (must be allowed by your SMTP provider)
SMTP_FROM=office@example.com

# Gmail example (use an App Password, not your normal password):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password

# For port 465 + SSL (some hosts), set:
# SMTP_SSL=true
# SMTP_PORT=465
